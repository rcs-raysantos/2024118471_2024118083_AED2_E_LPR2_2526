<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.FollowController" stylesheets="@style.css">
    <children>
        <BorderPane AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
            <top>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <padding><Insets bottom="10"/></padding>
                    <Label text="Utilizador:"/>
                    <TextField fx:id="txtSearchEmail" promptText="Nome ou Email..." prefWidth="250"/>
                    <Button text="Ver Seguidores" onAction="#handleListFollowers" styleClass="button-primary"/>
                    <Button text="Ver A Seguir" onAction="#handleListFollowing" styleClass="button-secondary"/>
                </HBox>
            </top>
            <center>
                <TableView fx:id="tblSocial">
                    <columns>
                        <TableColumn fx:id="colUserId" text="ID/Email" prefWidth="200"/>
                        <TableColumn fx:id="colUserName" text="Nome" prefWidth="300"/>
                    </columns>
                </TableView>
            </center>
        </BorderPane>
    </children>
</AnchorPane>