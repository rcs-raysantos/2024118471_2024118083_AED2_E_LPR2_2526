<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <TabPane prefHeight="800.0" prefWidth="1200.0" tabClosingPolicy="UNAVAILABLE"
                 AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                 AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <tabs>

                <Tab text="Users">
                    <content>
                        <fx:include source="UserView.fxml" />
                    </content>
                </Tab>

                <Tab text="Contents">
                    <content>
                        <fx:include source="ContentView.fxml" />
                    </content>
                </Tab>

                <Tab text="Artists">
                    <content>
                        <fx:include source="ArtistView.fxml" />
                    </content>
                </Tab>

                <Tab text="Graphs">
                    <content>
                        <fx:include source="GraphView.fxml" />
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </children>
</AnchorPane>