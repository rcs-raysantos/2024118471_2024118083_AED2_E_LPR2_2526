<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.controller.UserController" stylesheets="@style.css">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Nome:"/>
            <TextField fx:id="txtFiltroNome" promptText="Procurar..."/>
            <Label text="Região:"/>
            <TextField fx:id="txtFiltroRegiao" prefWidth="60" promptText="PT"/>
            <Label text="Desde:"/>
            <DatePicker fx:id="dpInicio"/>
            <Label text="Até:"/>
            <DatePicker fx:id="dpFim"/>
            <Button text="Filtrar" onAction="#handleFiltrar"/>
            <Button text="Limpar" onAction="#handleLimparFiltros"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tblUsers">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="100"/>
                <TableColumn fx:id="colNome" text="Nome" prefWidth="150"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="150"/>
                <TableColumn fx:id="colRegiao" text="Região" prefWidth="60"/>
                <TableColumn fx:id="colRegisto" text="Data Registo" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <right>
        <VBox spacing="10" prefWidth="250">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <Label text="Registar / Editar Utilizador" styleClass="label-header"/>

            <Label text="Nome:"/>
            <TextField fx:id="txtFormNome"/>

            <Label text="Email:"/>
            <TextField fx:id="txtFormEmail"/>

            <Label text="Senha:"/>
            <PasswordField fx:id="txtFormSenha"/>

            <Label text="Região (Código):"/>
            <TextField fx:id="txtFormRegiao" promptText="PT"/>

            <Label text="Data Nascimento:"/>
            <DatePicker fx:id="dpFormNascimento"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Salvar" onAction="#handleSalvar" styleClass="button-primary"/>
                <Button text="Remover" onAction="#handleRemover" styleClass="button-danger"/>
            </HBox>
        </VBox>
    </right>

    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>

            <Label text="Persistência de Dados (R10):" style="-fx-text-fill: #8197a4; -fx-font-style: italic;"/>

            <Button text="Importar Dados (.txt)" onAction="#handleImportarDados" styleClass="button-secondary"/>
            <Button text="Exportar Dados (.txt)" onAction="#handleExportarDados" styleClass="button-primary"/>
        </HBox>
    </bottom>

</BorderPane>